{
  "name": "envpilot",
  "version": "0.1.0",
  "description": "Lightweight environment-variable validation toolkit for Node.js",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "envpilot": "bin/envpilot.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "env",
    "environment",
    "config",
    "validation",
    "dotenv",
    "12factor"
  ],
  "author": "",
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-jsdoc": "^65.4.5",
    "prettier": "^3.9.10",
    "vitest": "^4.1.12"
  }
}
